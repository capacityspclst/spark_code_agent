{
 "steps": [
  {
   "do": "goto",
   "path": "/"
  },
  {
   "do": "screen",
   "name": "policy"
  },
  {
   "do": "check",
   "label": "I agree to the Terms of Use and Privacy Policy."
  },
  {
   "do": "click",
   "role": "button",
   "name": "Continue"
  },
  {
   "do": "screen",
   "name": "dashboard empty"
  },
  {
   "do": "expect",
   "text": "No activity yet"
  },
  {
   "do": "click",
   "role": "button",
   "name": "Add receipt"
  },
  {
   "do": "upload",
   "role": "button",
   "name": "Choose from library",
   "file": "receipt.png"
  },
  {
   "do": "wait",
   "ms": 500
  },
  {
   "do": "screen",
   "name": "receipt form"
  },
  {
   "do": "fill",
   "label": "Amount",
   "value": "42.10"
  },
  {
   "do": "fill",
   "label": "Date",
   "value": "{today}"
  },
  {
   "do": "select",
   "label": "Category",
   "option": "Supplies"
  },
  {
   "do": "select",
   "label": "Type",
   "option": "Expense"
  },
  {
   "do": "fill",
   "label": "Notes",
   "value": "Business lunch"
  },
  {
   "do": "click",
   "role": "button",
   "name": "Save receipt"
  },
  {
   "do": "expect",
   "text": "Receipt saved"
  },
  {
   "do": "screen",
   "name": "dashboard with receipt"
  },
  {
   "do": "expect",
   "text": "42.10"
  },
  {
   "do": "click",
   "role": "button",
   "name": "Add mileage"
  },
  {
   "do": "screen",
   "name": "mileage form"
  },
  {
   "do": "fill",
   "label": "Date",
   "value": "{today}"
  },
  {
   "do": "fill",
   "label": "Miles",
   "value": "50"
  },
  {
   "do": "fill",
   "label": "Purpose",
   "value": "Client meeting"
  },
  {
   "do": "click",
   "role": "button",
   "name": "Save mileage"
  },
  {
   "do": "expect",
   "text": "Mileage entry saved"
  },
  {
   "do": "screen",
   "name": "dashboard with receipt and mileage"
  },
  {
   "do": "expect",
   "text": "50"
  },
  {
   "do": "expect",
   "text": "Income"
  },
  {
   "do": "expect",
   "text": "Expenses"
  },
  {
   "do": "expect",
   "text": "Mileage deduction"
  },
  {
   "do": "expect",
   "text": "Estimated tax"
  }
 ]
}