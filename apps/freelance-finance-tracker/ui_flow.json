{
 "steps": [
  {
   "do": "goto",
   "path": "/"
  },
  {
   "do": "screen",
   "name": "sign-up"
  },
  {
   "do": "fill",
   "label": "Email",
   "value": "{email}"
  },
  {
   "do": "fill",
   "label": "Password",
   "value": "{password}"
  },
  {
   "do": "fill",
   "label": "Confirm password",
   "value": "{password}"
  },
  {
   "do": "click",
   "role": "button",
   "name": "Create account"
  },
  {
   "do": "expect",
   "text": "No data yet. Add a receipt or mileage to get started."
  },
  {
   "do": "screen",
   "name": "empty dashboard"
  },
  {
   "do": "click",
   "role": "button",
   "name": "Log out"
  },
  {
   "do": "expect",
   "text": "Welcome back"
  },
  {
   "do": "screen",
   "name": "log in"
  },
  {
   "do": "fill",
   "label": "Email",
   "value": "{email}"
  },
  {
   "do": "fill",
   "label": "Password",
   "value": "{password}"
  },
  {
   "do": "click",
   "role": "button",
   "name": "Log in"
  },
  {
   "do": "expect",
   "text": "No data yet. Add a receipt or mileage to get started."
  },
  {
   "do": "screen",
   "name": "empty dashboard after login"
  },
  {
   "do": "click",
   "role": "button",
   "name": "Add Receipt"
  },
  {
   "do": "screen",
   "name": "receipt upload form"
  },
  {
   "do": "upload",
   "role": "button",
   "name": "Take photo",
   "file": "receipt.png"
  },
  {
   "do": "fill",
   "label": "Amount (USD)",
   "value": "123.45"
  },
  {
   "do": "fill",
   "label": "Date",
   "value": "{today}"
  },
  {
   "do": "fill",
   "label": "Vendor",
   "value": "Acme Corp"
  },
  {
   "do": "select",
   "label": "Category",
   "option": "Office"
  },
  {
   "do": "click",
   "role": "button",
   "name": "Upload receipt"
  },
  {
   "do": "expect",
   "text": "Receipt added successfully!"
  },
  {
   "do": "screen",
   "name": "dashboard with receipt"
  },
  {
   "do": "click",
   "role": "tab",
   "name": "Mileage"
  },
  {
   "do": "expect",
   "text": "No mileage entries recorded yet."
  },
  {
   "do": "screen",
   "name": "empty mileage"
  },
  {
   "do": "click",
   "role": "button",
   "name": "Add Mileage"
  },
  {
   "do": "screen",
   "name": "mileage entry form"
  },
  {
   "do": "fill",
   "label": "Date",
   "value": "{today}"
  },
  {
   "do": "fill",
   "label": "Start location",
   "value": "123 Main St"
  },
  {
   "do": "fill",
   "label": "End location",
   "value": "456 Oak Ave"
  },
  {
   "do": "fill",
   "label": "Distance (miles)",
   "value": "34.2"
  },
  {
   "do": "fill",
   "label": "Purpose (optional)",
   "value": "Client meeting"
  },
  {
   "do": "click",
   "role": "button",
   "name": "Save mileage"
  },
  {
   "do": "expect",
   "text": "Mileage saved!"
  },
  {
   "do": "screen",
   "name": "dashboard after mileage"
  },
  {
   "do": "click",
   "role": "tab",
   "name": "Dashboard"
  },
  {
   "do": "expect",
   "text": "Mileage deduction"
  },
  {
   "do": "screen",
   "name": "dashboard with data"
  },
  {
   "do": "click",
   "role": "tab",
   "name": "Export"
  },
  {
   "do": "screen",
   "name": "export"
  },
  {
   "do": "click",
   "role": "button",
   "name": "Export PDF"
  },
  {
   "do": "expect",
   "text": "PDF download started."
  },
  {
   "do": "click",
   "role": "button",
   "name": "Log out"
  },
  {
   "do": "expect",
   "text": "Welcome back"
  },
  {
   "do": "screen",
   "name": "log in after final logout"
  }
 ]
}