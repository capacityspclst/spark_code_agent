{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "jsx": "react-jsx",
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["expo-app/**/*.tsx", "expo-app/**/*.ts"],
  "exclude": ["node_modules", "babel.config.js", "metro.config.js"]
}
